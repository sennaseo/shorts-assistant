OPENAI_API_KEY=          # 대본(GPT) + 이미지 생성(gpt-image-2) 공용
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
USE_LLM=false
DEFAULT_TTS_VOICE=ko-KR-SunHiNeural
DEFAULT_TTS_RATE=+0%
NOTION_API_KEY=
NOTION_TARGET_PAGE_ID=
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=

# ── 서버 배포용 (로컬에선 비워 둠) ──
APP_PASSWORD=          # 채우면 접속 시 비밀번호 요구. 서버에선 필수
DOMAIN=                # 예: shorts-maker.duckdns.org (deploy 스크립트가 사용)
PIPELINE_HOST=         # 기본 127.0.0.1. 도커는 compose 가 0.0.0.0 으로 넣는다
